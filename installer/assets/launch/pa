#!/usr/bin/env bash
# Start the assistant with the phone channel. Plain `claude` has no Telegram; this adds the flag every time.
# Usage: ./pa            continue the last conversation (a fresh one starts when there is none)
#        ./pa <args...>  any other claude arguments
cd "$(dirname "$0")" || exit 1
export PATH="$HOME/.bun/bin:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
# One phone session per machine: a second one fights the first over the Telegram bot.
if pgrep -f "claude.*--channels plugin:telegram" >/dev/null 2>&1; then
  echo "[pa] A phone session is already running (the tray app, or another pa window)."
  echo "[pa] Two sessions fight over the Telegram bot. Use the tray icon's 'Open session in a terminal' instead."
  read -r -p "[pa] Start a second session anyway? [y/N] " yn
  case "$yn" in y|Y) ;; *) exit 0 ;; esac
fi
# Forget Claude's cached "recent failure" for the Telegram server so this session retries it.
F="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/mcp-needs-auth-cache.json"
if [ -f "$F" ]; then
  if command -v jq >/dev/null 2>&1; then jq 'del(."plugin:telegram:telegram")' "$F" > "$F.tmp" 2>/dev/null && mv "$F.tmp" "$F"
  elif command -v python3 >/dev/null 2>&1; then python3 -c 'import json,sys; p=sys.argv[1]; d=json.load(open(p)); d.pop("plugin:telegram:telegram",None); json.dump(d,open(p,"w"))' "$F" 2>/dev/null
  fi
fi
# The permission mode chosen in the installer lives in .claude/settings.json. It is passed explicitly because
# -c (continue) would otherwise restore whatever mode the previous session ran in.
MODEFLAG=""
grep -q '"defaultMode": "bypassPermissions"' .claude/settings.json 2>/dev/null && MODEFLAG="--permission-mode bypassPermissions"
grep -q '"defaultMode": "acceptEdits"' .claude/settings.json 2>/dev/null && MODEFLAG="--permission-mode acceptEdits"
# -c continues your last conversation in this folder (a fresh one starts when there is none).
# shellcheck disable=SC2086
exec claude -c $MODEFLAG --channels plugin:telegram@claude-plugins-official "$@"
